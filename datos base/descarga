import json
from urllib.error import HTTPError, URLError
from urllib.request import Request, urlopen

file_key = "IMJEVEv0IGemR8o4kpEpiK"
headers = {
    "X-Figma-Token": "YOUR_FIGMA_API_TOKEN"  # Reemplaza con tu token de API de Figma
}

url = f"https://api.figma.com/v1/files/{file_key}"

request = Request(url, headers=headers)

try:
    with urlopen(request) as response:
        data = json.loads(response.read().decode("utf-8"))
    with open("hormiga_diseno.json", "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=4)
    print("¡JSON descargado con éxito!")
except HTTPError as error:
    print(f"Error {error.code}: {error.read().decode('utf-8', errors='replace')}")
except URLError as error:
    print(f"Error de conexión: {error.reason}")